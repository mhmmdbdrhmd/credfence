def _normalise_fields(raw):
    """Map requested field names onto the schema, telling the user what moved."""
    out, moved = [], []
    for f in raw:
        c, changed = canonical_field(f)
        if changed:
            moved.append((f, c))
        if c not in out:
            out.append(c)
    if moved:
        sys.stderr.write(
            "vlt: using the schema's names for %s\n"
            % ", ".join("%s -> %s" % (a, b) for a, b in moved))
    unknown = [f for f in out if f not in V.FIELDS]
    if unknown:
        sys.stderr.write(
            "vlt: %s are not schema fields; they will be stored in `extra`.\n"
            "vlt: they are masked by default, but `vlt exec` will not map them\n"
            "vlt: to environment variables. Schema fields: %s\n"
            % (", ".join(unknown), ", ".join(V.FIELDS)))
    return out


def cmd_add(args):
    fields = _normalise_fields(
        [f.strip() for f in (args.fields or "").split(",") if f.strip()])
    if not fields:
        fields = {"login": ["username", "password"],
                  "token": ["token"], "apikey": ["key"],
                  "ssh": ["host", "port", "username", "password", "key"],
                  "database": ["host", "port", "username", "password", "path"],
                  "smtp": ["host", "port", "username", "password"],
                  }.get(args.type, ["username", "password", "token"])
    got = _term_prompt({"name": args.name, "type": args.type,
                        "fields": fields, "reason": "manual add"})
    return 0 if got else 1


def cmd_rm(args):
    if not V.exists(args.name):
        die("no such secret: %s" % args.name)
    if not args.yes:
        ans = input("delete %s permanently? [y/N] " % args.name)
        if ans.lower() != "y":
            return 1
    V.delete(args.name)
    V.audit("rm", args.name)
    print("deleted %s" % args.name)
    return 0


def cmd_set(args):
    """Non-interactive field set — human only, for migration."""
    rec = V.load(args.name) if V.exists(args.name) else V.blank_record(
        args.name, args.type)
    val = args.value
    if val == "-":
        val = sys.stdin.read().rstrip("\n")
    if args.field in V.FIELDS:
        rec["fields"][args.field] = val
    else:
        rec["extra"][args.field] = val
    if args.env:
        rec["env_map"][args.env] = args.field
    if args.tag:
        for t in args.tag.split(","):
            if t and t not in rec["tags"]:
                rec["tags"].append(t)
    if args.note:
        rec["notes"] = args.note
    rec["rotated"] = V._now()
    V.save(rec)
    V.audit("set", args.name, "field=%s" % args.field)
    sys.stderr.write("vlt: set %s.%s\n" % (args.name, args.field))
    return 0


