def _populated_fields(rec):
    """Fields that currently hold a value."""
    return ([f for f, v in rec["fields"].items() if v not in (None, "")]
            + sorted(rec.get("extra", {}).keys()))


def _valid_fields(rec):
    """Every name that may legitimately be hidden, populated or not."""
    return list(V.FIELDS) + sorted(rec.get("extra", {}).keys())


def cmd_hide(args):
    """[human] Choose which fields `peek` masks for this record."""
    rec = V.load(args.name)
    known = _populated_fields(rec)
    valid = _valid_fields(rec)
    cur = V.hidden_fields(rec)

    if args.list:
        print("record   : %s" % args.name)
        print("fields   : %s" % ", ".join(known))
        print("hidden   : %s" % (", ".join(sorted(cur)) or "(nothing)"))
        print("shown    : %s" % (", ".join(f for f in known if f not in cur)
                                 or "(nothing)"))
        return 0

    if args.all:
        new = set(known)
    elif args.none:
        new = set()
    else:
        want = [f.strip() for f in (args.fields or "").split(",") if f.strip()]
        if not want:
            die("say which fields: vlt hide %s username,token   "
                "(or --all / --none / --list)" % args.name)
        unknown = [f for f in want if f not in valid]
        if unknown:
            die("not part of the record schema: %s\n"
                "     valid field names: %s"
                % (", ".join(unknown), ", ".join(valid)))
        new = (cur - set(want)) if args.unhide else (cur | set(want))

    rec["hidden"] = sorted(new)
    V.save(rec)
    V.audit("hide", args.name, "hidden=%s" % ",".join(sorted(new)))
    print("hidden fields for %s: %s"
          % (args.name, ", ".join(sorted(new)) or "(nothing)"))
    shown = [f for f in known if f not in new]
    if shown:
        print("now shown in full to agents: %s" % ", ".join(shown))
    return 0


def cmd_rename(args):
    """[human] Move a record to a new name, re-encrypting it."""
    old, new = args.name, args.new_name
    if not V.exists(old):
        die("no such secret: %s" % old)
    if V.exists(new) and not args.force:
        die("%s already exists — pass --force to overwrite it" % new)
    if not V.NAME_RE.match(new):
        die("bad name %r — lowercase <provider>/<account>[/<purpose>], "
            "e.g. vps/beta/3x-ui" % new)

    rec = V.load(old)
    rec["name"] = new
    rec["provider"] = new.split("/")[0]
    V.save(rec)                       # encrypts under the new name's subkey
    V.delete(old)
    V.audit("rename", new, "from %s" % old)
    sys.stderr.write("vlt: %s -> %s\n" % (old, new))
    return cmd_peek(argparse.Namespace(name=new, chars=4))


