            print("keyring     : %s" % (V.keyring_backend() or "disabled"))
    except Exception as exc:
        ok = False
        print("master key  : MISSING (%s)" % exc)
    names = V.all_names()
    print("secrets     : %d" % len(names))
    bad = []
    for n in names:
