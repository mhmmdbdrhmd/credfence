    hook = os.path.expanduser("~/.claude/hooks/vault-guard.py")
    print("guard hook  : %s" % ("installed" if os.path.exists(hook) else "MISSING"))
    print("caller      : %s" % V.caller())
    print("result      : %s" % ("OK" if ok else "PROBLEMS FOUND"))
