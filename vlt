#!/usr/bin/env python3
"""vlt — centralized credential vault.

Agents may DISCOVER (list/peek) and MOVE (exec/file/render) secrets.
Agents may never SEE a secret value, and may never hunt for credentials elsewhere.
If a secret is missing, `vlt request` opens a separate window for the human.
"""

import argparse
import getpass
import re
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

os.umask(0o077)

# Code lives next to this program; VLT_HOME holds data and may point anywhere.
_HERE = os.path.dirname(os.path.realpath(__file__))
for _cand in (_HERE,
              os.path.expanduser("~/.local/share/vlt"),
              os.environ.get("VLT_HOME", "")):
    if _cand and os.path.exists(os.path.join(_cand, "vltlib.py")):
        sys.path.insert(0, _cand)
        break
else:
    sys.stderr.write(
        "vlt: cannot find vltlib.py next to %s, in ~/.local/share/vlt, "
        "or in VLT_HOME.\n     Reinstall with ./install.sh\n" % _HERE)
    raise SystemExit(3)

import vltlib as V  # noqa: E402


def die(msg, code=2):
    sys.stderr.write("vlt: %s\n" % msg)
    sys.exit(code)


def agent_block(cmd):
    """Refuse value-revealing commands to agents, even without the hook."""
    if V.is_agent() and cmd in V.policy()["agent_denied_commands"]:
        V.audit("denied-agent", "-", "command %s" % cmd, ok=False)
        die(("`vlt %s` reveals secret values and is not available to agents.\n" % cmd) +
            "     Use instead:  vlt list | vlt peek <name> | vlt exec <name> -- CMD\n"
            "                   vlt file <name> <field> --out PATH\n"
            "                   vlt render --secret <name> --out FILE\n"
            "     If the secret does not exist yet:  vlt request <name> --fields ...",
            13)



NEEDS_CONFIRM = {"get", "show", "export", "identity", "hide", "unhide",
                 "set", "import", "rm", "rename", "ui", "keyring"}


# How long to wait for a person to answer a confirmation dialog. Refusing after
# this is the safe direction: a prompt nobody answers must not become a process
# nobody notices.
CONFIRM_TIMEOUT = 120


def _has_gui():
    """Is there a desktop session a dialog could actually appear on?

    On Linux that question is DISPLAY. On macOS `osascript` exists whether or
    not anyone is logged in at the screen, so it answers nothing; asking
    launchctl which session manager owns this process does. "Aqua" means a
    real login session — a daemon, an SSH login or a CI runner says otherwise.
    """
    if os.environ.get("VLT_NO_DESKTOP") == "1":
        # Said out loud, because there is nothing to detect. A CI runner has a
        # real Aqua session and will happily draw a dialog nobody will answer.
        return False
    if sys.platform == "darwin":
        try:
            r = subprocess.run(["launchctl", "managername"],
                               capture_output=True, text=True, timeout=5)
            return r.stdout.strip() == "Aqua"
        except Exception:
            return False
    return bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))


def confirm_human(cmd, detail=""):
    """Prove a person is present. An env var alone is not proof.

    A controlling terminal means someone typed this. Otherwise ask on the
    desktop, which an agent can trigger but cannot answer.
    """
    if os.environ.get("VLT_TEST_CONFIRM") == "1":
        return
    try:
        if sys.stdin.isatty() and sys.stdout.isatty():
            return
    except Exception:
        pass

    msg = ("A process is asking to run:\n\n    vlt %s %s\n\n"
           "This can expose credential values.\n"
           "Allow it only if you started it yourself." % (cmd, detail))

    dialog = None
    if (sys.platform == "darwin" and shutil.which("osascript")
            and _has_gui()):
        script = ('display dialog %s with title "vlt \u2014 confirm" '
                  'buttons {"Deny", "Allow"} default button "Deny" '
                  'with icon caution' % json.dumps(msg))
        dialog = ["osascript", "-e", script]
        # osascript exits 0 for BOTH buttons; only Esc gives non-zero. The
        # answer is in stdout, so it has to be read rather than inferred.
        approved = lambda r: b"Allow" in r.stdout
    elif shutil.which("zenity") and _has_gui():
        dialog = ["zenity", "--question", "--title", "vlt \u2014 confirm",
                  "--text", msg, "--ok-label", "Allow",
                  "--cancel-label", "Deny", "--default-cancel"]
        approved = lambda r: True          # zenity says Deny with exit 1

    if dialog:
        try:
            r = subprocess.run(dialog, capture_output=True,
                               timeout=CONFIRM_TIMEOUT)
        except subprocess.TimeoutExpired:
            V.audit("confirm", detail or "-",
                    "no answer within %ds for %s" % (CONFIRM_TIMEOUT, cmd),
                    ok=False)
            die("no answer at the confirmation dialog within %ds — refused."
                % CONFIRM_TIMEOUT, 17)
        if r.returncode == 0 and approved(r):
            V.audit("confirm", detail or "-", "approved at the desktop for %s" % cmd)
            return
        V.audit("confirm", detail or "-", "denied at the desktop for %s" % cmd,
                ok=False)
        die("denied at the confirmation dialog.", 17)

    die("`vlt %s` needs a real terminal or a desktop confirmation.\n"
        "     VLT_HUMAN=1 on its own is not proof that a person is present —\n"
        "     a script could set it. Run this from your own terminal." % cmd, 17)


# ------------------------------------------------------------------ out-of-band UI

def _term_prompt(spec):
    """Collect fields from the human in a SEPARATE terminal window."""
    payload = tempfile.NamedTemporaryFile(
        "w", suffix=".json", delete=False, dir=V.ROOT)
    json.dump(spec, payload)
    payload.close()
    os.chmod(payload.name, 0o600)
    helper = [sys.executable, os.path.abspath(__file__), "_prompt", payload.name]

    launched = False
    if (sys.platform == "darwin" and shutil.which("osascript")
            and _has_gui()):
        # Terminal.app's `do script` returns as soon as the window opens, so
        # there is nothing to wait on. The helper drops a marker beside the
        # payload when the person is finished, and that is what is waited for.
        done = payload.name + ".done"
        quoted = " ".join("'%s'" % a.replace("'", "'\\''") for a in helper)
        try:
            subprocess.run(
                ["osascript", "-e",
                 'tell application "Terminal" to do script %s'
                 % json.dumps("%s; touch %s; exit" % (quoted, done)),
                 "-e", 'tell application "Terminal" to activate'],
                check=False, timeout=30)
            deadline = time.time() + 900
            while time.time() < deadline and not os.path.exists(done):
                time.sleep(0.4)
            launched = os.path.exists(done)
        except Exception:
            launched = False
        finally:
            try:
                os.unlink(done)
            except OSError:
                pass
    if not launched and shutil.which("gnome-terminal") and _has_gui():
        try:
            subprocess.run(
                ["gnome-terminal", "--wait", "--title",
                 "vlt — enter credentials", "--"] + helper,
                check=False, timeout=900)
            launched = True
        except Exception:
            launched = False
    if not launched and shutil.which("xterm") and _has_gui():
        try:
            subprocess.run(["xterm", "-T", "vlt — enter credentials", "-e"]
                           + helper, check=False, timeout=900)
            launched = True
        except Exception:
            launched = False
    if not launched:
        if V.is_agent():
            os.unlink(payload.name)
            die("cannot open a separate window for credential entry.\n"
                "     Ask the user to run, in their own terminal:\n"
                "       VLT_HUMAN=1 vlt add %s" % spec["name"], 14)
        subprocess.run(helper, check=False)

    try:
        with open(payload.name) as fh:
            result = json.load(fh)
    except Exception:
        result = {}
    finally:
        try:
            os.unlink(payload.name)
        except OSError:
            pass
    return result.get("_saved") and result or None


def _more_queued(timeout=0.05):
    """Is there more input already waiting, i.e. was this a paste?

    Only meaningful on a terminal. On a pipe select() reports ready until EOF,
    which would make one field swallow the whole script.
    """
    if not sys.stdin.isatty():
        return False
    try:
        import select
        return bool(select.select([sys.stdin], [], [], timeout)[0])
    except Exception:
        return False


def _read_field(label, hidden=False, multiline=False):
    """One field value from the terminal, which may span lines.

    Single-line by default. Two things extend it:

      * a declared multi-line field (a key, a certificate) reads until EOF
        (Ctrl-D) or a line holding a single "."; and
      * ANY field auto-extends when its first line is PEM/OpenSSH armour,
        reading on until the matching END. Pasting a private key into a prompt
        that was not expecting one therefore works rather than silently
        truncating.

    Echo is suppressed by hand instead of by getpass, because getpass restores
    the terminal with TCSAFLUSH and throws away the rest of the paste.
    """
    # Echo goes off BEFORE the prompt is shown: anything typed or pasted the
    # moment the prompt appears would otherwise be echoed in the gap.
    fd = None
    saved = None
    if hidden and sys.stdin.isatty():
        try:
            import termios
            fd = sys.stdin.fileno()
            saved = termios.tcgetattr(fd)
            quiet = list(saved)
            quiet[3] &= ~termios.ECHO                      # lflags
            termios.tcsetattr(fd, termios.TCSADRAIN, quiet)
        except Exception:
            fd = saved = None

    hint = ""
    if multiline:
        hint = "  (paste it, then Ctrl-D — or a line with a single '.')\n"
    sys.stdout.write(hint + label)
    sys.stdout.flush()

    lines = []
    absorbing = False           # a paste is arriving; keep reading it
    try:
        while True:
            line = sys.stdin.readline()
            if hidden:
                # Echo is off, so nothing moved the cursor. Keep the prompt
                # readable without revealing what was typed.
                sys.stdout.write("\n")
                sys.stdout.flush()
            if not line:                                   # EOF / Ctrl-D
                break
            line = line.rstrip("\n").rstrip("\r")
            if not lines and not multiline and not V.PEM_BEGIN_RE.match(line):
                # An empty answer means "skip this field". It has no second
                # line, so anything queued behind it belongs to the NEXT
                # prompt and must be left there.
                if not line or not _more_queued():
                    return line                            # the ordinary case
                # More was pasted than one line. Keeping it is the point: the
                # alternative is that it becomes the next field's answer.
                absorbing = True
            if multiline and line == ".":
                break
            lines.append(line)
            if V.PEM_END_RE.match(line):
                break
            if absorbing and not _more_queued():
                break
    finally:
        if saved is not None:
            import termios
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)
    while lines and not lines[-1]:
        lines.pop()
    return "\n".join(lines)


def cmd__prompt(args):
    """Runs INSIDE the separate terminal window. Never called by an agent."""
    with open(args.payload) as fh:
        spec = json.load(fh)
    name = spec["name"]

    # The form lets the person retarget the branch and set masking per field.
    if os.environ.get("VLT_PLAIN_PROMPT") != "1":
        try:
            import vltui
            rec = vltui.request_form(spec)
            if rec is None:
                print("\n  cancelled — nothing saved.")
                time.sleep(1.2)
                return 1
            V.save(rec)
            V.audit("add", rec["name"], "via request form")
            with open(args.payload, "w") as fh:
                json.dump({"_saved": True, "name": rec["name"]}, fh)
            print("saved and encrypted: %s" % rec["name"])
            time.sleep(1.2)
            return 0
        except Exception as exc:
            print("  (form unavailable: %s — falling back to prompts)" % exc)
            time.sleep(1.5)

    print("=" * 68)
    print("  vlt — credential entry")
    print("=" * 68)
    print("  secret : %s" % name)
    print("  type   : %s" % spec.get("type", "token"))
    if spec.get("reason"):
        print("  reason : %s" % spec["reason"])
    print("  Values are typed here and encrypted directly into the vault.")
    print("  They are NOT shown to the agent and NOT written to the chat.")
    print("  Leave a field empty to skip it. Ctrl-C aborts.")
    print("  A key or certificate can be pasted whole — entry only ends")
    print("  at the matching -----END----- line, or at Ctrl-D.")
    print("-" * 68)

    try:
        rec = V.load(name) if V.exists(name) else V.blank_record(
            name, spec.get("type", "token"))
    except Exception:
        rec = V.blank_record(name, spec.get("type", "token"))

    try:
        for f in spec.get("fields", []):
            multi = f in V.MULTILINE_FIELDS
            hidden = f in V.SECRET_FIELDS or f not in V.PUBLIC_FIELDS
            tag = "hidden" if hidden else "shown"
            if multi:
                tag += ", multi-line"
            val = _read_field("  %-12s (%s): " % (f, tag), hidden, multi)
            if val:
                if f in V.FIELDS:
                    rec["fields"][f] = val
                else:
                    rec["extra"][f] = val
        print("-" * 68)
        print("  The next two are optional labels, not credentials.")
        print("  Press Enter to skip either one.")
        print("    account : which identity this belongs to, when one provider")
        print("              has several logins (an email, a client name, 'work').")
        print("              Leave empty if the record name already says it.")
        print("    notes   : anything you want to read later. Never a secret;")
        print("              notes are shown in full by `vlt peek`.")
        acct = _read_field("  %-12s (opt) : " % "account")
        if acct:
            rec["account"] = acct
        note = _read_field("  %-12s (opt) : " % "notes")
        if note:
            rec["notes"] = note
    except (KeyboardInterrupt, EOFError):
        print("\n  aborted — nothing saved.")
        time.sleep(1.5)
        return 1

    # default env_map so `vlt exec` works for this record immediately
    if not rec["env_map"]:
        prov = name.split("/")[0].split(".")[0].upper().replace("-", "_")
        for f in ("token", "key", "secret", "password", "username", "host", "port"):
            if rec["fields"].get(f):
                rec["env_map"]["%s_%s" % (prov, f.upper())] = f
    rec["rotated"] = V._now()
    V.save(rec)
    V.audit("add", name, "via separate-window prompt")
    with open(args.payload, "w") as fh:
        json.dump({"_saved": True, "name": name}, fh)
    print("-" * 68)
    print("  saved and encrypted: %s" % name)
    print("  this window closes in 3s")
    time.sleep(3)
    return 0


def register_rendered(path):
    """Record a file that now holds live credential values, so the guard hook
    can refuse to let an agent read it back."""
    reg = os.path.join(V.ROOT, "rendered.json")
    try:
        with open(reg) as fh:
            paths = set(json.load(fh))
    except Exception:
        paths = set()
    paths.add(os.path.abspath(path))
    paths = {q for q in paths if os.path.exists(q)}
    fd = os.open(reg + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump(sorted(paths), fh, indent=1)
    os.replace(reg + ".tmp", reg)


# ------------------------------------------------------------------- agent-safe

def cmd_list(args):
    idx = V.read_index()
    if not idx:
        idx = V.reindex_all()
    import fnmatch
    names = sorted(idx)
    if args.glob:
        names = [n for n in names
                 if fnmatch.fnmatch(n, args.glob) or args.glob.lower() in n.lower()
                 or args.glob.lower() in " ".join(idx[n].get("tags", [])).lower()]
    if args.json:
        print(json.dumps({n: idx[n] for n in names}, indent=2))
        return 0
    if not names:
        print("no secrets match. To create one:")
        print("  vlt request <provider>/<account> --fields username,password")
        return 0
    print("%-34s %-9s %-28s %s" % ("NAME", "TYPE", "FIELDS", "TAGS"))
    for n in names:
        e = idx[n]
        print("%-34s %-9s %-28s %s" % (
            n, e.get("type", "?"), ",".join(e.get("fields", [])),
            ",".join(e.get("tags", []))))
    V.audit("list", args.glob or "*")
    return 0


def cmd_peek(args):
    V.check_access(args.name)
    rec = V.load(args.name)
    V.audit("peek", args.name)
    print("name     : %s" % rec["name"])
    print("type     : %s" % rec["type"])
    print("account  : %s" % V.one_line(rec.get("account", "")))
    print("tags     : %s" % ",".join(rec.get("tags", [])))
    print("env_map  : %s" % json.dumps(rec.get("env_map", {})))
    if rec.get("notes"):
        # Continuations are INDENTED. No real key is, so a note can never
        # forge one however many lines it runs to.
        note = V.display_lines(rec["notes"])
        print("notes    : %s" % note[0])
        for cont in note[1:]:
            print("           %s" % cont)
    hid = V.hidden_fields(rec)
    print("hidden   : %s" % (", ".join(sorted(hid)) or "(nothing)"))
    print("-" * 60)
    for f in V.FIELDS:
        v = rec["fields"].get(f)
        if v in (None, ""):
            continue
        print("%-12s %s" % (f + ":", V.preview(f, v, args.chars, f in hid)))
    for k, v in rec.get("extra", {}).items():
        print("%-12s %s" % (k + ":", V.preview(k, v, args.chars, k in hid)))
    print("-" * 60)
    print("structure only. To use it:  vlt exec %s -- <command>" % rec["name"])
    return 0


def _env_for(names):
    env = dict(os.environ)
    used = []
    for name in names:
        V.check_access(name)
        rec = V.load(name)
        emap = rec.get("env_map") or {}
        if not emap:
            prov = name.split("/")[0].split(".")[0].upper().replace("-", "_")
            emap = {"%s_%s" % (prov, f.upper()): f
                    for f, v in rec["fields"].items() if v}
        for var, field in emap.items():
            val = rec["fields"].get(field)
            if val is None:
                val = rec.get("extra", {}).get(field)
            if val is not None:
                env[var] = str(val)
                used.append(var)
        V.audit("exec-inject", name, "vars=%s" % ",".join(sorted(emap)))
    return env, used


# Commands whose whole job is to print the environment.
ENV_DUMPERS = {
    "env", "printenv", "set", "export", "declare", "typeset", "compgen",
    "getenv", "environ",
}


def _reject_env_dump(cmd, used, allow_interp=False):
    """Refuse a child command that would echo the injected secrets."""
    base = os.path.basename(cmd[0])
    if base in ENV_DUMPERS:
        die("`%s` prints the environment, which is where the secret was just "
            "injected. That would put the value straight into your output.\n"
            "     Run the program that consumes the credential instead." % base, 16)

    joined = " ".join(cmd)
    if re.search(r"/proc/(?:self|[0-9]+)/environ", joined):
        die("that command reads the process environment directly, which would "
            "expose the injected secret.", 16)

    if allow_interp:
        return
    for var in used:
        if re.search(r"\$\{?%s\b" % re.escape(var), joined):
            die("the command references $%s, the variable the secret was "
                "injected into. Pass it to a program that reads the environment "
                "itself; do not interpolate it into a command line, where it "
                "would appear in output, logs and shell history.\n"
                "     If a program genuinely needs it as an argument, a human can "
                "re-run with --allow-interpolation." % var, 16)

    for tok in cmd[1:]:
        if os.path.basename(tok) in ENV_DUMPERS:
            die("`%s` appears in the command and prints the environment, which "
                "would expose the injected secret." % os.path.basename(tok), 16)

    # A dumper in command position inside a shell string: sh -c 'env | grep X'.
    # Each argument is treated as its own script, so a dumper at the start of an
    # argument counts as command position.
    dumper_re = re.compile(
        r"(?:^|[|;&(]|\$\(|`)\s*(%s)\b" % "|".join(sorted(ENV_DUMPERS)))
    for tok in cmd:
        m = dumper_re.search(tok)
        if m:
            die("`%s` appears in command position inside the arguments and "
                "would print the environment the secret was injected into."
                % m.group(1), 16)


def cmd_exec(args):
    cmd = list(args.cmd)
    while cmd and cmd[0] == "--":
        cmd.pop(0)
    args.cmd = cmd
    if not cmd:
        die("nothing to run: vlt exec <name> -- <command...>")
    names = [n for n in args.name.split(",") if n]
    env, used = _env_for(names)
    allow_interp = getattr(args, "allow_interpolation", False)
    # REMAINDER captures the flag if it came after the name; honour it anyway.
    if "--allow-interpolation" in cmd:
        cmd = [c for c in cmd if c != "--allow-interpolation"]
        while cmd and cmd[0] == "--":
            cmd.pop(0)
        args.cmd = cmd
        allow_interp = True
    if allow_interp and V.is_agent():
        die("--allow-interpolation puts the secret on a command line, where it "
            "lands in output and history. It is available to humans only.", 13)
    _reject_env_dump(cmd, used, allow_interp)
    sys.stderr.write("vlt: injected %s into the child process\n" % ", ".join(used))
    try:
        return subprocess.call(args.cmd, env=env)
    except FileNotFoundError:
        die("command not found: %s" % args.cmd[0])


def cmd_file(args):
    V.check_access(args.name)
    rec = V.load(args.name)
    val = rec["fields"].get(args.field)
    if val is None:
        val = rec.get("extra", {}).get(args.field)
    if val is None:
        die("field %r is empty in %s (have: %s)"
            % (args.field, args.name,
               ",".join(f for f, v in rec["fields"].items() if v)))
    out = os.path.abspath(os.path.expanduser(args.out))
    os.makedirs(os.path.dirname(out), exist_ok=True)
    mode = int(args.mode, 8)
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    val = str(val)
    # An armoured value is terminated whether or not --newline was passed:
    # OpenSSH rejects a key whose final -----END----- has no newline after it,
    # and reports it as "invalid format" rather than as a missing byte.
    with os.fdopen(fd, "w") as fh:
        fh.write(val)
        if (args.newline or V.is_armoured(val)) and not val.endswith("\n"):
            fh.write("\n")
    os.chmod(out, mode)
    register_rendered(out)
    V.audit("file", args.name, "field=%s -> %s" % (args.field, out))
    sys.stderr.write("vlt: wrote %s field of %s -> %s (mode %s)\n"
                     % (args.field, args.name, out, args.mode))
    return 0


def cmd_render(args):
    names = [n for spec in args.secret for n in spec.split(",")]
    values = {}
    for name in names:
        V.check_access(name)
        rec = V.load(name)
        for var, field in (rec.get("env_map") or {}).items():
            v = rec["fields"].get(field)
            if v is None:
                v = rec.get("extra", {}).get(field)
            if v is not None:
                values[var] = str(v)
        for f, v in rec["fields"].items():
            if v is not None:
                values["%s.%s" % (name, f)] = str(v)
        V.audit("render", name, "-> %s" % args.out)

    if args.template:
        tpl_path = args.template
        if not os.path.exists(tpl_path):
            alt = os.path.join(V.TEMPLATES, args.template)
            tpl_path = alt if os.path.exists(alt) else tpl_path
        if not os.path.exists(tpl_path):
            die("no such template: %s" % args.template)
        with open(tpl_path) as fh:
            body = fh.read()
        for k, v in values.items():
            body = body.replace("{{%s}}" % k, v).replace("${%s}" % k, v)
        missing = [t for t in ("{{", "}}") if t in body]
        if missing and not args.allow_unresolved:
            die("template still has unresolved placeholders; "
                "run `vlt peek` to check field names, or pass --allow-unresolved")
    else:
        body = "".join("%s=%s\n" % (k, v) for k, v in sorted(values.items())
                       if "." not in k)

    out = os.path.abspath(os.path.expanduser(args.out))
    os.makedirs(os.path.dirname(out), exist_ok=True)
    mode = int(args.mode, 8)
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as fh:
        fh.write(body)
    os.chmod(out, mode)
    register_rendered(out)
    sys.stderr.write("vlt: rendered %d value(s) -> %s (mode %s). "
                     "Do not cat this file.\n" % (len(values), out, args.mode))
    return 0


def cmd_request(args):
    name = args.name
    if V.exists(name) and not args.force:
        sys.stderr.write("vlt: %s already exists — use it, do not re-request.\n"
                         % name)
        return cmd_peek(argparse.Namespace(name=name, chars=4))
    fields = _normalise_fields(
        [f.strip() for f in args.fields.split(",") if f.strip()])
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-u", "critical", "vlt: credential needed",
                        "%s — a window has opened for you to enter it" % name],
                       check=False)
    sys.stderr.write("vlt: opening a separate window for the user to enter %s ...\n"
                     % name)
    V.audit("request", name, "fields=%s reason=%s" % (",".join(fields), args.reason))
    got = _term_prompt({"name": name, "type": args.type,
                        "fields": fields, "reason": args.reason})
    if not got:
        die("the user did not provide %s. Stop and ask them in chat to run:\n"
            "       VLT_HUMAN=1 vlt add %s" % (name, name), 15)
    print("stored: %s" % name)
    return cmd_peek(argparse.Namespace(name=name, chars=4))


def cmd_audit(args):
    if not os.path.exists(V.AUDIT):
        print("no audit log yet")
        return 0
    with open(V.AUDIT) as fh:
        lines = fh.readlines()
    for ln in lines[-args.tail:]:
        try:
            e = json.loads(ln)
        except Exception:
            continue
        if args.name and e.get("secret") != args.name:
            continue
        sess = (e.get("session") or "-")[:8]
        if args.session and not (e.get("session") or "").startswith(args.session):
            continue
        print("%s  %-8s %-6s %-14s %-28s %s%s" % (
            e["ts"], sess, e["who"], e["action"], e["secret"],
            "" if e.get("ok", True) else "DENIED ", e.get("detail", "")))
    return 0


