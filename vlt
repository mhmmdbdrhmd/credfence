def cmd_keyring(args):
    """[human] List or prune the keyring entries vlt owns, on either backend."""
    backend = V.keyring_backend()
    if backend is None:
        die("keyring access is disabled (VLT_NO_KEYRING=1).", 4)
    try:
        mine = V.keyring_items()
    except ImportError:
        die("no keyring library is available on this system; nothing to manage.",
            4)
    except Exception as exc:
        die("could not reach the keyring: %s" % exc, 4)

    if not mine:
        print("no vlt keys in the %s keyring" % backend)
        return 0

    def vault_of(label):
        """Which vault an entry belongs to, from the label vlt wrote."""
        m = re.search(r"\((.+)\)$", label)
        if m:
            return m.group(1)
        if label == "vlt-master-identity":
            return os.path.join(V.HOME, ".local/share/vlt")
        return None

    rows = []
    for label, account in mine:
        root = vault_of(label)
        gone = bool(root) and not os.path.exists(os.path.join(root, "index.json"))
        rows.append((label, account, root, gone))
    stale = [r for r in rows if r[3]]

    print("backend: %s" % backend)
    print("%-58s %s" % ("KEYRING ENTRY", "VAULT"))
    for label, _, _, gone in rows:
        print("%-58s %s" % (label[:57], "missing" if gone else "present"))

    if args.action == "list":
        if stale:
            print()
            print("%d entr%s point at a vault that no longer exists."
                  % (len(stale), "y" if len(stale) == 1 else "ies"))
            print("Remove them with:  VLT_HUMAN=1 vlt keyring prune")
        return 0

    if not stale:
        print()
        print("nothing to prune")
        return 0

    print()
    print("About to delete %d key(s) for vaults that no longer exist."
          % len(stale))
    print("If one of those vaults is only temporarily unmounted, its secrets "
          "become")
    print("unreadable for ever. Nothing else is touched.")
    if not args.yes:
        if input("proceed? [y/N] ").lower() != "y":
            return 1
    for label, account, _, _ in stale:
        V.keyring_delete(label, account)
        V.audit("keyring-prune", "-", "deleted %s" % label)
        print("deleted %s" % label)
    return 0

# --------------------------------------------------------------------- scanning
# `vlt scan` is a REPORT: it finds credential-shaped files so a person can decide
# what to migrate. It never opens a value it does not have to, never prints one,
# and never moves anything.

# Directories with nothing of ours in them. Walking them is slow and noisy, and
# a hit inside a package cache is somebody else's fixture, not your secret.
SCAN_SKIP = re.compile(
    r"/(?:\.git|\.hg|\.svn|node_modules|__pycache__|\.venv|venv|\.tox|"
    r"\.cache|\.local/share/vlt|\.local/share/Trash|snap|\.mozilla|"
    r"site-packages|dist-packages|\.gradle|\.m2|\.cargo/registry|"
    r"Library/Caches|\.Trash)/")

# Filenames that are credential files by name alone.
SCAN_NAMES = re.compile(
    r"^(?:\.env(?!\.(?:example|sample|template|dist|tpl)$)(?:\..*)?"
    r"|[A-Za-z0-9_.-]*\.env"
    r"|\.netrc|_netrc|\.npmrc|\.pypirc|\.git-credentials"
    r"|credentials(?:\..*)?|secrets?\.(?:json|ya?ml|env|txt|py|js|ts)"
    r"|id_rsa|id_dsa|id_ecdsa|id_ed[0-9]+"
    r"|.*\.(?:pem|pfx|p12|jks|keystore))$", re.IGNORECASE)

# Containers whose bytes are not text worth reading for field names. A .pem may
# hold a public certificate, which is not a secret, so those are opened once to
# check for private key material and otherwise dropped.
BINARYISH = re.compile(r"\.(?:pem|pfx|p12|jks|keystore|der|crt|cer)$",
                       re.IGNORECASE)

# --deep only: a secret-shaped ASSIGNMENT, not merely the word "password".
SCAN_CONTENT = re.compile(
    r"(?:BEGIN\s+(?:RSA|OPENSSH|EC|PGP|DSA)?\s*PRIVATE\s+KEY"
    # The name may be quoted (JSON, YAML), so allow a closing quote before
    # the separator: `"api_key": "..."` as well as `API_KEY=...`.
    r"|(?:api[_-]?key|secret|passwo?rd|token|access[_-]?key)"
    r"['\"]?\s*[=:]\s*['\"]?[^\s'\",}]{8,}"
    r"|\bghp_[A-Za-z0-9]{20,}|\bgithub_pat_|\bsk-[A-Za-z0-9]{20,}"
    r"|\bxox[baprs]-|\bAKIA[A-Z0-9]{12,}|\bAIza[A-Za-z0-9_-]{20,}"
    r"|\bglpat-|\bshpat_)", re.IGNORECASE)

# Only an identifier-shaped left-hand side is reported as a field name. Without
# this, a base64 line of a PEM key matched `NAME:` and the scan printed slices
# of the key itself under "keys:" — the one thing this command must never do.
IDENT_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_.-]{1,39}$")

# Credentials the machine itself needs where they are. A record of these belongs
# in the vault; the live file stays put, and the guard keeps agents out of it.
MACHINE_KEEP = re.compile(
    r"(?:/\.ssh/|/\.gnupg/|/\.cert/nm-openvpn/|/\.config/kdeconnect/|"
    r"/\.mitmproxy/|/\.claude/\.credentials\.json|/Library/Keychains/|"
    r"/etc/)")


def _me():
    """A default account name that is not the author's."""
    try:
        return re.sub(r"[^a-z0-9._-]+", "-", getpass.getuser().lower()) or "me"
    except Exception:
        return "me"


def _suggest(path):
    base = os.path.basename(path).lower()
    parent = os.path.basename(os.path.dirname(path)).lower()
    parent = re.sub(r"[^a-z0-9._-]+", "-", parent).strip("-") or "misc"
    if base in (".netrc", "_netrc"):
        return "heroku.com/%s" % _me(), "login"
    if base == ".npmrc":
        return "npmjs.com/%s" % _me(), "token"
    if base == ".pypirc":
        return "pypi.org/%s" % _me(), "token"
    if base.startswith(".env"):
        return "project/%s" % parent, "service"
    if base.endswith((".pem", ".p12", ".pfx", ".jks")):
        return "cert/%s" % re.sub(r"[^a-z0-9._-]+", "-", base.rsplit(".", 1)[0]), "cert"
    if base.startswith("id_"):
        return "ssh/%s" % base[3:], "ssh"
    return "project/%s" % parent, "service"


def cmd_scan(args):
    roots = args.root or [os.path.expanduser("~")]
    hits = []
    for root in roots:
        for dirpath, dirnames, filenames in os.walk(root):
            if SCAN_SKIP.search(dirpath + "/"):
                dirnames[:] = []
                continue
            depth = dirpath[len(root):].count(os.sep)
            if depth >= args.depth:
                dirnames[:] = []
            for fn in filenames:
                fp = os.path.join(dirpath, fn)
                try:
                    st = os.stat(fp)
                except OSError:
                    continue
                if st.st_size == 0 or st.st_size > 512 * 1024:
                    continue
                why = None
                if SCAN_NAMES.match(fn):
                    why = "name"
                    if BINARYISH.search(fn):
                        # a public cert or CA bundle is not a secret
                        try:
                            with open(fp, "r", errors="ignore") as fh:
                                head = fh.read(200000)
                        except OSError:
                            continue
                        if "PRIVATE KEY" not in head and not fn.lower().endswith(
                                (".pfx", ".p12", ".jks", ".keystore")):
                            continue
                elif args.deep and fn.endswith(
                        (".json", ".yaml", ".yml", ".ini", ".cfg", ".conf",
                         ".sh", ".py", ".js", ".ts", ".txt")):
                    try:
                        with open(fp, "r", errors="ignore") as fh:
                            if SCAN_CONTENT.search(fh.read(65536)):
                                why = "content"
                    except OSError:
                        continue
                if not why:
                    continue
                keys = []
                if not BINARYISH.search(fn):
                    try:
                        with open(fp, "r", errors="ignore") as fh:
                            for ln in fh.read(65536).splitlines():
                                if ln.strip().startswith(("#", ";", "//")):
                                    continue
                                m = re.match(
                                    r"\s*(?:export\s+)?([A-Za-z0-9_.-]{2,40})\s*[=:]",
                                    ln)
                                # an identifier, never a slice of key material
                                if m and IDENT_RE.match(m.group(1)):
                                    keys.append(m.group(1))
                    except OSError:
                        pass
                name, rtype = _suggest(fp)
                hits.append({
                    "path": fp, "why": why, "bytes": st.st_size,
                    "mode": oct(st.st_mode & 0o777),
                    "mtime": time.strftime("%Y-%m-%d", time.localtime(st.st_mtime)),
                    "keys": sorted(set(keys))[:12],
                    "suggest": name, "type": rtype,
                    "machine_operational": bool(MACHINE_KEEP.search(fp)),
                })
    hits.sort(key=lambda h: (h["machine_operational"], h["path"]))
    V.audit("scan", "-", "%d candidate file(s)" % len(hits))

    if args.json:
        print(json.dumps(hits, indent=2))
        return 0
    move = [h for h in hits if not h["machine_operational"]]
    keep = [h for h in hits if h["machine_operational"]]
    print("CREDENTIAL INVENTORY  (%d file(s); NOTHING has been changed)" % len(hits))
    print()
    print("MIGRATE INTO THE VAULT  (%d)" % len(move))
    print("-" * 78)
    for h in move:
        print("  %s" % h["path"])
        print("      %s bytes, mode %s, modified %s, matched by %s"
              % (h["bytes"], h["mode"], h["mtime"], h["why"]))
        if h["keys"]:
            print("      keys: %s" % ", ".join(h["keys"]))
        print("      suggested: vlt import '%s' --name %s --type %s"
              % (h["path"], h["suggest"], h["type"]))
    print()
    print("LEAVE IN PLACE — the OS needs these where they are  (%d)" % len(keep))
    print("-" * 78)
    for h in keep:
        print("  %s   (mode %s)" % (h["path"], h["mode"]))
    print()
    print("No file was read into this transcript, moved or deleted.")
    print("Import one with:  VLT_HUMAN=1 vlt import <path> --name <name>")
    return 0


def _parse_credfile(path):
    """Best-effort key/value extraction. Returns dict."""
    out = {}
    base = os.path.basename(path).lower()
    try:
        with open(path, "r", errors="ignore") as fh:
            text = fh.read()
    except OSError as exc:
        die("cannot read %s: %s" % (path, exc))
    if base in (".netrc", "_netrc"):
        toks = text.split()
        cur = None
        for i, t in enumerate(toks):
            if t == "machine" and i + 1 < len(toks):
                cur = toks[i + 1]
                out.setdefault("host", cur)
            elif t == "login" and i + 1 < len(toks):
                out.setdefault("username", toks[i + 1])
            elif t == "password" and i + 1 < len(toks):
                out.setdefault("password", toks[i + 1])
        return out
    if base.endswith((".pem", ".p12", ".pfx", ".jks")) or base.startswith("id_"):
        return {"key": text}
    if text.lstrip().startswith("{"):
        try:
            data = json.loads(text)
            if isinstance(data, dict):
                for k, v in data.items():
                    if isinstance(v, (str, int)):
                        out[k] = str(v)
                return out
        except Exception:
            pass
    seen = {}
    for ln in text.splitlines():
        ln = ln.strip()
        if not ln or ln.startswith(("#", ";", "//")):
            continue
        m = re.match(r"(?:export\s+)?([A-Za-z0-9_.-]+)\s*[=:]\s*(.*)$", ln)
        if not m:
            continue
        k, v = m.group(1), m.group(2).strip().strip("\"\'")
        if not v:
            continue
        # A file listing several servers repeats keys. Keep every occurrence,
        # suffixed, rather than letting the last one win silently.
        seen[k] = seen.get(k, 0) + 1
        out[k if seen[k] == 1 else "%s_%d" % (k, seen[k])] = v
    return out


FIELD_ALIASES = {
    "user": "username", "usr": "username", "login": "username",
    "uname": "username", "email": "username",
    "pass": "password", "pwd": "password", "passwd": "password",
    "apikey": "key", "api_key": "key", "access_key": "key",
    "access_token": "token", "auth_token": "token", "authtoken": "token",
    "api_token": "token", "apitoken": "token", "bot_token": "token",
    "secret_key": "secret", "client_secret": "secret", "private_key": "key",
    "hostname": "host", "server": "host", "ip": "host", "addr": "host",
    "endpoint": "url", "panel": "url", "dashboard": "url", "webhook": "url",
    "database": "path", "db": "path",
}


def canonical_field(name):
    """Map a field name onto the schema vocabulary, case-insensitively.

    Returns (canonical_name, was_remapped). Names with no mapping are left
    alone and end up in `extra` — still masked, but outside the uniform shape.
    """
    low = name.strip().lower()
    if low in V.FIELDS:
        return low, low != name
    if low in FIELD_ALIASES:
        return FIELD_ALIASES[low], True
    return name, False


def cmd_import(args):
    src = os.path.abspath(os.path.expanduser(args.path))
    if not os.path.exists(src):
        die("no such file: %s" % src)
    raw = _parse_credfile(src)
    if not raw:
        die("found no key/value pairs in %s" % src)
    name = args.name or _suggest(src)[0]
    rec = V.load(name) if V.exists(name) else V.blank_record(name, args.type)
    n = 0
    for k, v in raw.items():
        if v in (None, ""):
            continue
        lk = k.lower().lstrip("_")
        field = FIELD_ALIASES.get(lk, lk if lk in V.FIELDS else None)
        if field:
            rec["fields"][field] = v
            rec["env_map"].setdefault(k.upper(), field)
        else:
            rec["extra"][k] = v
            rec["env_map"].setdefault(k.upper(), k)
        n += 1
    dupes = sorted({re.sub(r"_\d+$", "", k) for k in raw
                    if re.search(r"_\d+$", k)})
    if dupes:
        sys.stderr.write(
            "vlt: NOTE %s repeats %s — it probably describes more than one host.\n"
            "vlt: all occurrences were kept as <key>_2, <key>_3 in `extra`.\n"
            "vlt: consider splitting them into separate records, one per host.\n"
            % (os.path.basename(src), ", ".join(dupes)))
    rec["notes"] = (rec.get("notes") or "") or ("imported from %s" % src)
    if "imported" not in rec["tags"]:
        rec["tags"].append("imported")
    rec["rotated"] = V._now()
    V.save(rec)
    V.audit("import", name, "from %s, %d field(s)" % (src, n))
    sys.stderr.write("vlt: imported %d field(s) from %s -> %s\n" % (n, src, name))
    sys.stderr.write("vlt: the ORIGINAL FILE WAS NOT TOUCHED: %s\n" % src)
    return cmd_peek(argparse.Namespace(name=name, chars=4))



def cmd_identity(args):
    """[human] Back up or restore the master key. Without a backup, losing
    gnome-keyring means losing every secret in the vault, permanently."""
    import base64
    if args.action == "export":
        key = V.master_key()
        out = os.path.abspath(os.path.expanduser(args.out))
        fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o400)
        with os.fdopen(fd, "w") as fh:
            fh.write("# vlt master key - ANYONE WITH THIS FILE CAN DECRYPT THE\n"
                     "# ENTIRE VAULT. Keep it offline (paper, USB in a drawer).\n"
                     "# Restore with:  VLT_HUMAN=1 vlt identity <import> <thisfile>\n")
            fh.write("VLT-MASTER-V1:" + base64.b64encode(key).decode() + "\n")
        V.audit("identity-export", "-", "-> %s" % out)
        sys.stderr.write(
            "vlt: master key written to %s (mode 0400).\n"
            "vlt: MOVE IT OFF THIS MACHINE. It decrypts everything.\n" % out)
        return 0

    src = os.path.abspath(os.path.expanduser(args.out))
    if not os.path.exists(src):
        die("no such file: %s" % src)
    key = None
    with open(src) as fh:
        for ln in fh:
            if ln.startswith("VLT-MASTER-V1:"):
                key = base64.b64decode(ln.split(":", 1)[1].strip())
    if not key or len(key) != 32:
        die("no valid VLT-MASTER-V1 line in %s" % src)
    V._keyring_set(key)
    if V._keyring_get() != key:
        fd = os.open(V.FALLBACK_KEY, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o400)
        with os.fdopen(fd, "wb") as fh:
            fh.write(key)
    V._MASTER = None
    V.audit("identity-import", "-", "from %s" % src)
    sys.stderr.write("vlt: master key restored. Run `vlt doctor` to verify.\n")
    return 0


# ------------------------------------------------------------------------- parser

def main():
    p = argparse.ArgumentParser(prog="vlt", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="_sub")

    s = sub.add_parser("init", help="create the vault and master key")
    s.set_defaults(fn=cmd_init)

    s = sub.add_parser("list", help="list secrets (names/fields only, no values)")
    s.add_argument("glob", nargs="?")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("peek", help="show STRUCTURE of a secret, not its value")
    s.add_argument("name")
    s.add_argument("--chars", type=int, default=4,
                   help="leading chars of secret fields to reveal (default 4)")
    s.set_defaults(fn=cmd_peek)

    s = sub.add_parser("exec", help="run a command with the secret in its environment")
    s.add_argument("name", help="secret name, or comma-separated names")
    s.add_argument("--allow-interpolation", action="store_true",
                   help="[human] permit $VAR on the child command line")
    s.add_argument("cmd", nargs=argparse.REMAINDER)
    s.set_defaults(fn=cmd_exec)

    s = sub.add_parser("file", help="write one field straight to a file")
    s.add_argument("name")
    s.add_argument("field")
    s.add_argument("--out", required=True)
    s.add_argument("--mode", default="0600")
    s.add_argument("--newline", action="store_true",
                   help="append a trailing newline (automatic "
                        "for PEM/OpenSSH armoured values)")
    s.set_defaults(fn=cmd_file)

    s = sub.add_parser("render", help="fill a template and write it to a file")
    s.add_argument("--secret", action="append", required=True)
    s.add_argument("--template")
    s.add_argument("--out", required=True)
    s.add_argument("--mode", default="0600")
    s.add_argument("--allow-unresolved", action="store_true")
    s.set_defaults(fn=cmd_render)

    s = sub.add_parser("request", help="ask the human for a missing secret")
    s.add_argument("name")
    s.add_argument("--fields", default="username,password")
    s.add_argument("--type", default="token", choices=V.TYPES)
    s.add_argument("--reason", default="")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_request)

    s = sub.add_parser("scan", help="inventory credential files (report only)")
