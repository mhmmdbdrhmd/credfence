    s.add_argument("name")
    s.add_argument("fields", nargs="?")
    s.add_argument("--all", action="store_true", help=argparse.SUPPRESS)
    s.add_argument("--none", action="store_true", help=argparse.SUPPRESS)
    s.add_argument("--list", action="store_true", help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_hide, unhide=True)

    s = sub.add_parser("rename", help="[human] rename a secret, keeping its value")
    s.add_argument("name")
    s.add_argument("new_name")
    s.add_argument("--force", action="store_true",
                   help="overwrite the destination if it exists")
    s.set_defaults(fn=cmd_rename)

    s = sub.add_parser("ui", help="[human] browse the vault in a terminal UI")
    s.set_defaults(fn=cmd_ui)

    s = sub.add_parser("keyring",
                       help="[human] list or prune vlt's keyring entries")
    s.add_argument("action", choices=["list", "prune"], nargs="?",
                   default="list")
    s.add_argument("--yes", action="store_true")
    s.set_defaults(fn=cmd_keyring)

    s = sub.add_parser("guard", help="set hook enforcement: on|warn|off|status")
    s.add_argument("mode", choices=["on", "warn", "off", "status"])
    s.set_defaults(fn=cmd_guard)

    s = sub.add_parser("reindex", help="rebuild index.json from the store")
    s.set_defaults(fn=cmd_reindex)

    s = sub.add_parser("identity",
                       help="[human] back up / restore the master key")
    s.add_argument("action", choices=["export", "import"])
    s.add_argument("out", help="file to write to / read from")
    s.set_defaults(fn=cmd_identity)

    s = sub.add_parser("doctor", help="check vault health")
    s.set_defaults(fn=cmd_doctor)

    s = sub.add_parser("_values", help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_values)

    s = sub.add_parser("_prompt", help=argparse.SUPPRESS)
    s.add_argument("payload")
    s.set_defaults(fn=cmd__prompt)

    args = p.parse_args()
    if not getattr(args, "fn", None):
        p.print_help()
        return 0
    subcmd = getattr(args, "_sub", None)
    agent_block(subcmd)
    if subcmd in NEEDS_CONFIRM:
        name = getattr(args, "name", "")
        confirm_human(subcmd, name if isinstance(name, str) else "")
    try:
        return args.fn(args)
    except V.Denied as exc:
        die(str(exc), 13)
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main() or 0)
