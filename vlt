    s = sub.add_parser("import", help="[human] import a credential file (copies, "
                                      "never deletes the original)")
    s.add_argument("path")
    s.add_argument("--name")
    s.add_argument("--type", default="service", choices=V.TYPES)
    s.set_defaults(fn=cmd_import)

    s = sub.add_parser("audit", help="show the access log")
    s.add_argument("--tail", type=int, default=40)
    s.add_argument("--name")
    s.add_argument("--session",
                   help="only entries from this session id (prefix is enough)")
    s.set_defaults(fn=cmd_audit)

    s = sub.add_parser("get", help="[human] print one field")
    s.add_argument("name")
    s.add_argument("field")
    s.set_defaults(fn=cmd_get)

    s = sub.add_parser("show", help="[human] print the whole record")
    s.add_argument("name")
    s.set_defaults(fn=cmd_show)

    s = sub.add_parser("add", help="[human] add a secret in a separate window")
    s.add_argument("name")
    s.add_argument("--fields")
    s.add_argument("--type", default="token", choices=V.TYPES)
    s.set_defaults(fn=cmd_add)

    s = sub.add_parser("set", help="[human] set one field non-interactively")
    s.add_argument("name")
    s.add_argument("field")
    s.add_argument("value", help="value, or - to read stdin")
    s.add_argument("--type", default="token", choices=V.TYPES)
    s.add_argument("--env", help="env var name to map this field to")
    s.add_argument("--tag")
    s.add_argument("--note")
    s.set_defaults(fn=cmd_set)

    s = sub.add_parser("rm", help="[human] delete a secret")
    s.add_argument("name")
    s.add_argument("--yes", action="store_true")
    s.set_defaults(fn=cmd_rm)

    s = sub.add_parser("hide",
                       help="[human] choose which fields `peek` masks")
    s.add_argument("name")
    s.add_argument("fields", nargs="?",
                   help="comma-separated field names")
    s.add_argument("--all", action="store_true", help="hide every field")
    s.add_argument("--none", action="store_true", help="hide nothing")
